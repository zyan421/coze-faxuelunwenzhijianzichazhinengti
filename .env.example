# ============================================================
# 法学论文质检自查智能体 - 环境变量配置模板
# ============================================================
# 本文件为配置示例，复制为 .env 后填入真实值
# ⚠️ 严禁将真实 API Key 提交到 Git 仓库！
# ⚠️ .env 文件已加入 .gitignore，不会被提交
# ============================================================

# -----------------------------------------------------------
# 【必填】BYOK 模式：你自己的大模型 API Key
# -----------------------------------------------------------
# 推荐使用 DeepSeek（性价比高、法学能力强）：
#   1. 访问 https://platform.deepseek.com 注册并创建 API Key
#   2. 将 Key 填入下方
# 其他可选平台：OpenAI、阿里云百炼、SiliconFlow 等
#
# ⚠️ 代码支持以下环境变量名（任一有效即可）：
#   CUSTOM_MODEL_API_KEY  ← 推荐
#   DEEPSEEK_API_KEY
#   OPENAI_API_KEY
#   COZE_API_KEY
#   deepseek_coze_coding  ← 你在 Coze 平台部署设置中自定义的变量名
CUSTOM_MODEL_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------
# 【必填】BYOK 模式：模型 API 的 Base URL
# -----------------------------------------------------------
# DeepSeek 官方：https://api.deepseek.com
# OpenAI 官方：https://api.openai.com
# 阿里云百炼：https://dashscope.aliyuncs.com/compatible-mode/v1
# SiliconFlow：https://api.siliconflow.cn/v1
CUSTOM_MODEL_BASE_URL=https://api.deepseek.com

# -----------------------------------------------------------
# 【选填】BYOK 模式：模型名称
# -----------------------------------------------------------
# 不同平台的模型名称不同，以下是常用推荐：
# DeepSeek：deepseek-chat（推荐）、deepseek-reasoner
# OpenAI：gpt-4o、gpt-4o-mini
# 阿里云：qwen-max、qwen-turbo
# SiliconFlow：deepseek-ai/DeepSeek-V3
CUSTOM_MODEL_NAME=deepseek-chat

# -----------------------------------------------------------
# 【选填】对象存储配置（用于上传批注文档和 PDF 报告）
# -----------------------------------------------------------
# 如果部署到自有服务器，需要配置 S3 兼容的对象存储
# 以下使用 Coze 平台内置存储（沙箱环境已自动配置，一般无需修改）
# COZE_S3_ACCESS_KEY=xxx
# COZE_S3_SECRET_KEY=xxx
# COZE_S3_ENDPOINT=https://tos-s3-cn-beijing.volces.com
# COZE_S3_BUCKET=coze_storage_xxx
# COZE_S3_REGION=cn-beijing

# -----------------------------------------------------------
# 【自动注入】以下环境变量由平台自动提供，无需手动填写
# -----------------------------------------------------------
# COZE_WORKLOAD_IDENTITY_API_KEY=（平台自动注入）
# COZE_INTEGRATION_MODEL_BASE_URL=（平台自动注入）
# COZE_WORKSPACE_PATH=/workspace/projects（平台自动注入）
